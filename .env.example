# ---------- Database ----------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------- Dashboard ----------
ADMIN_KEY=choose-a-long-password
CRON_SECRET=choose-another-long-random-string

# ---------- AI (set GEMINI_API_KEY to use free Gemini, otherwise OpenRouter is used) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
ARTICLE_LANGUAGE=English

# ---------- WordPress ----------
WP_URL=https://your-site.com
WP_USER=
WP_APP_PASSWORD=

# ---------- Reddit leads ----------
BUSINESS_CONTEXT=We build ... for ... (1-2 sentences; the AI uses this to judge leads)
SUBREDDITS=india,smallbusiness
LEAD_KEYWORDS=looking for,need recommendation,where to buy,best service for,want to buy
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:automation-magic:1.0 (by /u/your_username)
OFFER=Free 15-minute consultation
WHATSAPP_GROUP_INVITE=
COURSE_PITCH=
DEFAULT_COUNTRY_CODE=91

# ---------- Optional ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_PLACES_KEY=
RESEARCH_MODE=off
